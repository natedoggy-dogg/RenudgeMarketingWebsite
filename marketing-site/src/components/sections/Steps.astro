---
// "How it works": three to five steps, each a nudge numeral, a display-s
// title and a short muted paragraph, opened by a hairline.
interface Props {
  steps: { title: string; body: string }[];
  level?: 'h3' | 'h4';
}
const { steps, level: Heading = 'h3' } = Astro.props;
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="step">
        <span class="n" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div>
          <Heading>{s.title}</Heading>
          <p>{s.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: var(--space-6);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
  }
  .n {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 44px;
    color: var(--nudge);
    font-variant-numeric: lining-nums;
  }
  h3,
  h4 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 30px;
    font-weight: 500;
  }
  p {
    margin: var(--space-2) 0 0;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 26px;
    max-width: 56ch;
  }
  @media (max-width: 720px) {
    .step {
      grid-template-columns: 56px minmax(0, 1fr);
      column-gap: var(--space-4);
    }
  }
</style>
