---
// A dashboard table for ProductFrame, with an optional page title and count
// line. Counts must agree with the rows drawn.
import Badge, { type BadgeTone } from '../labels/Badge.astro';

export type Cell = string | { primary: string; sub?: string } | { badge: string; tone: BadgeTone };
interface Props {
  title?: string;
  count?: string;
  columns: string[];
  rows: Cell[][];
  /** grid-template-columns for the rows. The default fits client, progress, state, next nudge. */
  template?: string;
}
const {
  title,
  count,
  columns,
  rows,
  template = 'minmax(120px, 1.4fr) 70px 110px minmax(120px, 1fr)',
} = Astro.props;
---

{
  title && (
    <div class="product-title">
      {title}
      {count && <span class="count product-body"> · {count}</span>}
    </div>
  )
}
<div class="rows" role="table" style={`--cols: ${template}`}>
  <div class="tr head" role="row">
    {
      columns.map((c) => (
        <span role="columnheader">{c}</span>
      ))
    }
  </div>
  {
    rows.map((r) => (
      <div class="tr" role="row">
        {r.map((c) => (
          <span role="cell">
            {typeof c === 'string' ? (
              c
            ) : 'badge' in c ? (
              <Badge label={c.badge} tone={c.tone} product />
            ) : (
              <>
                <b>{c.primary}</b>
                {c.sub && <span class="sub">{c.sub}</span>}
              </>
            )}
          </span>
        ))}
      </div>
    ))
  }
</div>

<style>
  .count {
    color: var(--product-muted);
    font-weight: 400;
    letter-spacing: 0;
  }
  .rows {
    margin-top: 12px;
    border: 1px solid var(--product-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    min-width: 460px;
  }
  .tr {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 12px;
    align-items: center;
    padding: 10px 14px;
    border-top: 1px solid var(--product-chip);
    font-size: 13px;
    line-height: 18px;
  }
  .head {
    border-top: 0;
    background: var(--product-sidebar);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--product-muted);
    padding: 8px 14px;
  }
  .sub {
    display: block;
    font-size: 12px;
    color: var(--product-muted);
  }
</style>
